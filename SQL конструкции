  Создание таблицы GradeLog
CREATE TABLE IF NOT EXISTS GradeLog (
    id SERIAL PRIMARY KEY,
    student_id INT NOT NULL,
    subject_id INT NOT NULL,
    grade INT NOT NULL,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_student FOREIGN KEY (student_id) REFERENCES Students(id) ON DELETE CASCADE,
    CONSTRAINT fk_subject FOREIGN KEY (subject_id) REFERENCES Subjects(id) ON DELETE CASCADE
);

Создание функции триггера LogGradeInsert
CREATE OR REPLACE FUNCTION LogGradeInsert()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO GradeLog (student_id, subject_id, grade, timestamp)
    VALUES (NEW.student_id, NEW.subject_id, NEW.grade, CURRENT_TIMESTAMP);
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

Создание триггера after_grade_insert
CREATE TRIGGER after_grade_insert
AFTER INSERT ON Grades
FOR EACH ROW
EXECUTE FUNCTION LogGradeInsert();
